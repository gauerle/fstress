formulas:
  Untitled: ""
views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasProperty("citekey")
    order:
      - file.name
      - title
      - year
      - design
      - countries
      - samplesize
      - units
      - theories
      - scales
      - keyfindings
    sort:
      - property: year
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 95
      note.title: 116
      note.design: 106
      note.countries: 134
      note.units: 102
      note.theories: 157
      note.scales: 106
